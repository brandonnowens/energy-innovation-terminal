# ==============================================================================
# ENERGY INNOVATION TERMINAL - FRONTEND CONFIGURATION
# ==============================================================================

# Backend API Endpoint URL (Leave empty for local proxy, or set to production API domain)
VITE_API_URL=http://127.0.0.1:8000

# MapTiler API Key (For vector maps and geospatial award tiles)
VITE_MAPTILER_API_KEY=your_maptiler_key_here

# App Environment
VITE_APP_ENV=production

# ==============================================================================
# GHOST.ORG SESSION GATING (terminal.aixenergy.io)
# ==============================================================================
# Enable Ghost member session detection. Defaults to true in production.
# Set to false to disable the access gate entirely (e.g. local dev).
VITE_GHOST_AUTH_ENABLED=true

# Ghost publication base URL (no trailing slash)
VITE_GHOST_URL=https://www.aixenergy.io

# Ghost Portal signup / signin deep links
VITE_GHOST_SIGNUP_URL=https://www.aixenergy.io/#/portal/signup
VITE_GHOST_SIGNIN_URL=https://www.aixenergy.io/#/portal/signin

# Path on the Ghost site that reads the member cookie and postMessages a token.
# The Map app's existing bridge page is reused here by default.
VITE_GHOST_AUTH_BRIDGE_PATH=/map-auth-bridge/
