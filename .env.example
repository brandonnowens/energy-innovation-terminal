# ==============================================================================
# Energy Innovation Terminal - Commercial Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Cluster
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/nyserda_innovation
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_SSL_MODE=prefer

# ------------------------------------------------------------------------------
# 2. CORS & Network Security
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins or '*' for wildcard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://energyinnovation.terminal

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
PUBLIC_BENEFIT_MODE=true

# ------------------------------------------------------------------------------
# 4. System Admin & Correspondence Integration
# ------------------------------------------------------------------------------
ADMIN_PRIMARY_EMAIL=bowens@aixenergy.io
ADMIN_PRIMARY_NAME=Brandon Owens
ADMIN_GMAIL_USER=bowens@aixenergy.io
ADMIN_GMAIL_PASSWORD=
ADMIN_SMTP_HOST=smtp.gmail.com
ADMIN_SMTP_PORT=587
ADMIN_SMTP_USE_TLS=true
ADMIN_IMAP_HOST=imap.gmail.com
ADMIN_IMAP_PORT=993
ADMIN_IMAP_USE_SSL=true

# ------------------------------------------------------------------------------
# 5. AI Engine & LLM Providers (OpenAI, Gemini, Anthropic)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 6. Conversational Video Advisor (Tavus.io)
# ------------------------------------------------------------------------------
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=

# ------------------------------------------------------------------------------
# 7. External Data Ingestion & API Feeds
# ------------------------------------------------------------------------------
SOCRATA_APP_TOKEN=
GRANTS_GOV_API_KEY=
SAM_GOV_API_KEY=

# ------------------------------------------------------------------------------
# 8. Server Host & Local Storage
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
