# API-only image for the Cloudflare Container.
# The React app is deployed separately to Cloudflare Pages.
# Build context is the repository root.

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/backend \
    MALLOC_ARENA_MAX=2 \
    PORT=8000 \
    ENABLE_BACKGROUND_SCHEDULERS=false \
    SKIP_STARTUP_WARM=true \
    DB_POOL_SIZE=3 \
    DB_MAX_OVERFLOW=2 \
    WEB_CONCURRENCY=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r ./backend/requirements.txt

COPY backend/ ./backend/
RUN mkdir -p /app/data /app/backend/data

EXPOSE 8000

# Lifespan opens the port only after init_db returns. SKIP_STARTUP_WARM
# keeps that path to schema checks plus imports, so a cold start can finish
# inside the Worker's port-ready window.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --app-dir backend --workers 1 --limit-concurrency 50 --timeout-keep-alive 30 --proxy-headers --forwarded-allow-ips '*'"]
