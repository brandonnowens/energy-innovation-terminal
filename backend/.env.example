# ==============================================================================
# ENERGY INNOVATION TERMINAL - BACKEND CONFIGURATION
# ==============================================================================

# Database Connection (PostgreSQL with psycopg2 or asyncpg)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/nyserda_innovation

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_SSL_MODE=prefer

# Environment & Server
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS) - Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://energy-terminal.app

# AI / LLM Integrations
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# In-Memory Cache TTL (Seconds)
CACHE_TTL_SECONDS=300
