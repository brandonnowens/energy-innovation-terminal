{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "energy-innovation-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "EnergyApiContainer",
      "image": "../../Dockerfile.api",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "EnergyApiContainer",
        "name": "ENERGY_API"
      }
    ]
  },
  "exports": {
    "EnergyApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
